require "securerandom"
require "openssl"
require "fileutils"
require "plist"

default_platform(:ios)

# All auth here goes through an App Store Connect API key (Issuer ID + Key ID +
# .p8 key content) — never an Apple ID password or 2FA prompt, which is the
# only way any of this can run unattended on a CI runner nobody is sitting at.
#
# key_content takes the .p8 file's raw text as-is (starting with
# "-----BEGIN PRIVATE KEY-----") — no encoding step needed, so the
# GitHub secret can just be a copy-paste of the file's contents.
def api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"].to_s.strip
  raw_key = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].to_s.strip

  UI.user_error!("The APP_STORE_CONNECT_API_KEY_ID repo secret is missing or empty.") if key_id.empty?
  UI.user_error!("The APP_STORE_CONNECT_API_ISSUER_ID repo secret is missing or empty.") if issuer_id.empty?
  UI.user_error!("The APP_STORE_CONNECT_API_KEY_CONTENT repo secret is missing or empty.") if raw_key.empty?

  # Copy-pasting a multi-line .p8 file through a phone (GitHub's secret box
  # included) routinely mangles the line breaks: real newlines get collapsed
  # away, turned into literal two-character "\n" sequences, or left as CRLF.
  # Any of those makes the PEM unparsable even though the key material itself
  # is intact, so normalize before handing it to OpenSSL.
  raw_key = raw_key.gsub("\r\n", "\n").gsub('\n', "\n")
  unless raw_key.include?("\n")
    raw_key = raw_key
      .sub(/-----BEGIN (EC )?PRIVATE KEY-----\s*/, "-----BEGIN \\1PRIVATE KEY-----\n")
      .sub(/\s*-----END (EC )?PRIVATE KEY-----\s*\z/, "\n-----END \\1PRIVATE KEY-----\n")
  end

  begin
    parsed_key = OpenSSL::PKey.read(raw_key)
  rescue OpenSSL::PKey::PKeyError, ArgumentError => e
    UI.user_error!("Couldn't parse APP_STORE_CONNECT_API_KEY_CONTENT as a private key (#{e.message}). Re-copy the .p8 file's full contents — including the -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY----- lines — into that secret, exactly as downloaded.")
  end

  # Apple's .p8 is PKCS#8. spaceship (which this action delegates to) loads
  # it via OpenSSL::PKey::EC.new directly, which some OpenSSL/LibreSSL builds
  # — seen on GitHub's macos-latest runners — fail on with "invalid curve
  # name" even though the key itself is fine. Re-exporting through the
  # generic, format-auto-detecting OpenSSL::PKey.read loader (above) and
  # back out converts it losslessly to the older, far more
  # universally-supported SEC1 format ("-----BEGIN EC PRIVATE KEY-----") —
  # same key material, just a different ASN.1 wrapper.
  sec1_key = parsed_key.to_pem

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: sec1_key,
    is_key_content_base64: false,
  )
end

# Shared by bootstrap_signing's two failure paths below (get_certificates
# itself refusing to make a new one, and it silently reusing one this
# machine has no key for) — both come down to the same fix: something on
# the account needs revoking by hand before a fresh, exportable certificate
# can be created.
def raise_existing_certificates_error!
  existing = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION,IOS_DISTRIBUTION" })
  listing = existing.any? ? existing.map { |c| "  - #{c.display_name} (id #{c.id}, expires #{c.expiration_date})" }.join("\n") : "  (none found — see the get_certificates output above this error for what actually happened)"

  UI.user_error!(<<~MSG)
    No new certificate was generated. Apple never lets a certificate's private key be downloaded after the fact — only whoever originally generated it still has it — so any certificate already on this account that this machine didn't just create is dead weight this pipeline can never use, and it can also block a new one from being created once the account hits its certificate limit:

    #{listing}

    Revoke it/them, then re-run this workflow so it creates a brand-new one it can actually export:
    1. Go to developer.apple.com/account > Certificates, Identifiers & Profiles > Certificates.
    2. Select the certificate(s) listed above and choose Revoke.
    3. Re-run the "iOS — bootstrap signing" workflow.
  MSG
end

platform :ios do
  # Run this lane once before the first TestFlight build. It registers the
  # bundle ID via the API key (works fine — confirmed by an actual run) and
  # then checks whether the App Store Connect app record exists.
  #
  # It cannot create that app record itself, and neither can any other tool
  # using an API key: Apple's App Store Connect REST API rejects a CREATE on
  # the "apps" resource unconditionally, for every key, with "The resource
  # 'apps' does not allow 'CREATE'. Allowed operations are: GET_COLLECTION,
  # GET_INSTANCE, UPDATE" — confirmed by an actual run against it. This isn't
  # a permissions gap to work around; new app listings only exist through
  # appstoreconnect.apple.com's own "+" button. (It's also why fastlane's
  # `produce` tool needs a real Apple ID session for app creation even when a
  # key is configured elsewhere — it's hitting this same wall and falls back
  # to the one path that isn't blocked.)
  #
  # So: safe to re-run, and it tells you exactly what to do by hand the one
  # time the app record doesn't exist yet.
  desc "Register the bundle ID; verify the App Store Connect app record exists"
  lane :create_app do
    api_key
    bundle_id = "com.pocketfox.companion"

    if Spaceship::ConnectAPI::BundleId.find(bundle_id)
      UI.message("Bundle ID #{bundle_id} is already registered.")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "PocketFox Companion", platform: "IOS", identifier: bundle_id)
      UI.success("Registered bundle ID #{bundle_id}.")
    end

    if Spaceship::ConnectAPI::App.find(bundle_id)
      UI.success("App Store Connect app record for #{bundle_id} already exists.")
    else
      UI.user_error!(<<~MSG)
        The bundle ID is registered, but there's no App Store Connect app record for #{bundle_id} yet — and no API key can create one; Apple's API blocks that for everyone. It has to be done once, by hand, by the Account Holder or an Admin, on the website:

        1. Go to appstoreconnect.apple.com > Apps > the "+" button > New App.
        2. Platform: iOS
        3. Name: PocketFox Companion
        4. Primary language: English (U.S.)
        5. Bundle ID: pick com.pocketfox.companion from the dropdown (it's already registered, so it'll be listed).
        6. SKU: any unique text, e.g. pocketfoxcompanion001 — never shown to users.
        7. Save.

        Then re-run this workflow — it'll report the app record already exists — and move on to the "iOS — TestFlight build" workflow.
      MSG
    end
  end

  # Run this lane exactly once (manually, via the "iOS — bootstrap signing"
  # GitHub Actions workflow) to create a fresh Apple Distribution certificate
  # and App Store provisioning profile for this app, and print out the
  # secrets to store for the ongoing "beta" lane below.
  #
  # This only works cleanly the FIRST time, before any "Apple Distribution"
  # certificate exists for this account under this key's access — Apple never
  # lets you re-download a certificate's private key after the fact, so if a
  # certificate already exists from elsewhere, this lane can't get its key and
  # tells you exactly which one(s) to revoke in App Store Connect first, so a
  # fresh, exportable cert+key pair gets generated instead.
  desc "Create a distribution certificate + provisioning profile, export as CI secrets"
  lane :bootstrap_signing do
    api_key

    # Anchored to the Fastfile's own on-disk location, not Dir.pwd — fastlane
    # itself changes the process's working directory to this "fastlane"
    # folder (ios/fastlane/) for the entire duration of every lane (see
    # Fastlane::Runner#execute's Dir.chdir(FastlaneFolder.path)), so
    # "./signing" resolves one level too deep, to ios/fastlane/signing/
    # instead of ios/signing/ — confirmed by an actual run that reported
    # success and even printed "Successfully generated ... which was
    # imported to the local machine", yet the GitHub Actions upload-artifact
    # step (looking at ios/signing/*, matching the working-directory: ios
    # set on the step that runs this lane) found nothing at all. __dir__
    # is fixed at this file's real path regardless of what any action here
    # or inside fastlane itself does to the working directory.
    signing_dir = File.expand_path("../signing", __dir__)
    FileUtils.mkdir_p(signing_dir)

    cert_password = SecureRandom.hex(16)

    begin
      get_certificates(
        output_path: signing_dir,
        generate_apple_certs: true,
      )
    rescue FastlaneCore::Interface::FastlaneError => e
      # Apple caps how many Distribution certificates an account can have
      # active at once. cert first deletes any certs it finds it can't use
      # (no local private key — expected and harmless on a fresh CI runner)
      # before trying to create a new one, but deleting the *local* leftovers
      # doesn't revoke them on Apple's side, so old, unusable certificates
      # can still occupy every slot and block the new one from ever being
      # created — surfaced by cert's own action as this exact error.
      if e.to_s.include?("reached the maximum number")
        raise_existing_certificates_error!
      else
        raise e
      end
    end

    # The exact ID of the certificate get_certificates just produced or
    # reused, straight from the same Lane Context value the printed table
    # shows (CERT_CERTIFICATE_ID) — authoritative, unlike guessing it back
    # out of whatever files happen to be sitting in signing_dir.
    cert_id = ENV["CER_CERTIFICATE_ID"]
    UI.user_error!("get_certificates didn't report a certificate ID at all — check its output above this error for what happened.") unless cert_id

    get_provisioning_profile(
      output_path: signing_dir,
      filename: "profile.mobileprovision",
    )

    # Despite the ".p12" name fastlane's cert action gives this file, it's
    # actually just the raw, unencrypted private key (confirmed by reading
    # Spaceship::ConnectAPI::Certificate.create_certificate_signing_request
    # and cert/runner.rb's create_certificate — it writes the OpenSSL::PKey
    # object straight to disk, no PKCS#12 packaging or password applied at
    # all). It's only present when a brand-new certificate was just created;
    # if the account already has one this key can't retrieve the private key
    # for, cert silently reuses it and produces no key file here at all.
    raw_key_path = File.join(signing_dir, "#{cert_id}.p12")
    raise_existing_certificates_error! unless File.exist?(raw_key_path)

    # Build a real, password-protected PKCS#12 ourselves from the raw key +
    # cert, since fastlane never does — this is what import_certificate in
    # the "beta" lane below actually expects.
    der_cert_path = File.join(signing_dir, "#{cert_id}.cer")
    UI.user_error!("Expected a matching certificate file at #{der_cert_path} but didn't find one.") unless File.exist?(der_cert_path)

    pem_cert_path = File.join(signing_dir, "#{cert_id}.pem")
    sh("openssl x509 -inform DER -in '#{der_cert_path}' -out '#{pem_cert_path}'")

    p12_path = File.join(signing_dir, "dist.p12")
    sh("openssl pkcs12 -export -inkey '#{raw_key_path}' -in '#{pem_cert_path}' -out '#{p12_path}' -passout pass:#{cert_password}")

    # Deliberately NOT -A (single unbroken line) here — these files get
    # opened and hand-copied on a phone, and a several-thousand-character
    # line with no breaks is exactly the kind of content a mobile text
    # preview can silently under-select ("Select All" grabbing only what's
    # rendered on screen), producing a corrupted or truncated secret no
    # matter how carefully it's copied. Standard wrapped base64 (the
    # default, ~64 chars/line) decodes back byte-for-byte identically —
    # base64 --decode ignores embedded newlines — but is trivially
    # selectable in full as an ordinary multi-line text file.
    sh("openssl base64 -in '#{p12_path}' -out '#{File.join(signing_dir, 'cert_base64.txt')}'")
    sh("openssl base64 -in '#{File.join(signing_dir, 'profile.mobileprovision')}' -out '#{File.join(signing_dir, 'profile_base64.txt')}'")
    File.write(File.join(signing_dir, "cert_password.txt"), cert_password)

    UI.important("Bootstrap complete. The 'iOS — bootstrap signing' workflow uploads ./ios/signing/ as a build artifact — download it, then add these repo secrets before deleting the artifact: IOS_DIST_CERT_P12_BASE64 (cert_base64.txt), IOS_DIST_CERT_PASSWORD (cert_password.txt), IOS_PROVISION_PROFILE_BASE64 (profile_base64.txt).")
  end

  desc "Build and upload a TestFlight build using the secrets bootstrap_signing produced"
  lane :beta do
    api_key

    keychain_password = SecureRandom.hex(16)
    create_keychain(
      name: "ci-build.keychain",
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 1800,
    )

    import_certificate(
      certificate_path: ENV["IOS_DIST_CERT_P12_PATH"],
      certificate_password: ENV["IOS_DIST_CERT_PASSWORD"],
      keychain_name: "ci-build.keychain",
      keychain_password: keychain_password,
    )

    install_provisioning_profile(path: ENV["IOS_PROVISION_PROFILE_PATH"])

    # Reference the just-installed profile by UUID rather than name — avoids
    # any assumption about what get_provisioning_profile happened to call it
    # during bootstrap_signing.
    #
    # Extracted directly via OpenSSL rather than shelling out to
    # `security cms -D` — an actual run proved the profile file itself was
    # completely correct (right size, right path, confirmed instants
    # earlier) yet `security cms` still couldn't read it, piping nothing to
    # PlistBuddy. `security cms -D` verifies the profile's Apple-issued
    # signature against the keychain's trust store before it'll output
    # anything, and this lane's "ci-build.keychain" is a bare, freshly
    # created keychain with no Apple root/intermediate certs in it — so it
    # never had the trust anchor available to satisfy that check, without
    # ever saying so directly. Parsing the same PKCS#7/CMS structure
    # ourselves via OpenSSL::PKCS7 with NOVERIFY reads out the embedded
    # plist directly and sidesteps that trust check entirely — this profile
    # was just downloaded from Apple's own API and installed successfully
    # one line above, so re-verifying its signature here serves no purpose.
    pkcs7 = OpenSSL::PKCS7.new(File.binread(ENV["IOS_PROVISION_PROFILE_PATH"]))
    pkcs7.verify([], OpenSSL::X509::Store.new, nil, OpenSSL::PKCS7::NOVERIFY)
    profile_plist = Plist.parse_xml(pkcs7.data)
    profile_uuid = profile_plist["UUID"]
    UI.user_error!("Could not read a UUID out of the installed provisioning profile.") unless profile_uuid

    # Automatic signing needs an explicit team ID to build under CI — with
    # no Xcode account signed in to resolve one implicitly, xcodebuild
    # otherwise refuses the archive with "Signing ... requires a
    # development team," confirmed by an actual run. Rather than have
    # someone hunt for this on Apple's site (APPLE_TEAM_ID is deliberately
    # optional — see the Appfile), read it out of the same profile plist
    # already parsed above: every provisioning profile embeds the team(s)
    # it belongs to.
    team_id = profile_plist["TeamIdentifier"]&.first
    UI.user_error!("Could not read a TeamIdentifier out of the installed provisioning profile.") unless team_id

    # xcodeproj: is required here for the same reason as build_app's
    # project: below — without it, this defaults to the current directory,
    # which during lane execution is ios/fastlane/, not the actual project.
    increment_build_number(
      xcodeproj: File.expand_path("../App/App.xcodeproj", __dir__),
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
    )

    # Passing CODE_SIGN_STYLE=Manual etc. as xcargs to build_app (below) is
    # not enough on its own — confirmed by an actual run that got past the
    # "requires a development team" error (proving the xcargs override does
    # reach xcodebuild) yet still failed to archive, this time with 'No
    # signing certificate "iOS Distribution" found', a completely different
    # certificate type name than the "Apple Distribution" one actually
    # created and passed. That mismatch is the signature of Xcode's
    # Automatic-signing certificate search still running underneath: the
    # .xcodeproj file on disk has CODE_SIGN_STYLE=Automatic baked in
    # (Capacitor's generated default), and once Automatic signing is what
    # the project itself declares, Xcode manages certificate matching
    # itself using its own internal legacy-type lookup — ignoring the
    # CODE_SIGN_IDENTITY override entirely — rather than treating the
    # command-line xcarg as authoritative. Writing Manual directly into the
    # project file itself (not just passing it as a build argument) is what
    # actually turns Automatic signing off before xcodebuild ever runs.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.expand_path("../App/App.xcodeproj", __dir__),
      targets: ["App"],
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_uuid,
    )

    build_app(
      # This Capacitor project uses Swift Package Manager (CapApp-SPM), not
      # CocoaPods — there is no .xcworkspace anywhere in it, only
      # App.xcodeproj, so this must be `project:`, not `workspace:`.
      # Absolute and anchored to the Fastfile's own location, not Dir.pwd —
      # fastlane changes the working directory to ios/fastlane/ for the
      # whole lane (see the note in bootstrap_signing above), so a bare
      # relative name would resolve one level too deep and never be found.
      project: File.expand_path("../App/App.xcodeproj", __dir__),
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.pocketfox.companion" => profile_uuid
        },
        teamID: team_id,
      },
      # The archive step (which happens before export, and is what was
      # actually failing) reads its signing setup straight from the
      # .xcodeproj's own build settings, not from export_options — and
      # Capacitor's generated project defaults to CODE_SIGN_STYLE=Automatic,
      # the mode meant for a developer logged into Xcode locally. With
      # nobody logged in here, Automatic can't resolve anything and Xcode
      # ends up trying (and failing) to manage its own profile instead of
      # using the real one we already installed — confirmed by an actual
      # run failing with "No profiles ... were found ... Automatic signing
      # is disabled and unable to generate a profile." Forcing Manual here,
      # with the exact identity/profile/team already set up above, makes
      # the archive actually use them instead of trying to self-manage.
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid} DEVELOPMENT_TEAM=#{team_id}",
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  ensure
    delete_keychain(name: "ci-build.keychain") rescue nil
  end
end
